# ============================================================
# PathDrift Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=pathdrift
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=pathdrift

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Application Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database URLs (used by backend directly, not needed in most docker setups) ---
DATABASE_URL=postgresql+asyncpg://pathdrift:CHANGE_ME_STRONG_PASSWORD@localhost:5432/pathdrift
DATABASE_URL_SYNC=postgresql://pathdrift:CHANGE_ME_STRONG_PASSWORD@localhost:5432/pathdrift
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# --- File storage ---
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
MAX_UPLOAD_SIZE_MB=500

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- External Data APIs (optional, for integrated data import) ---
# NCBI/Entrez (required for GEO import)
NCBI_API_KEY=
NCBI_EMAIL=your.email@institution.edu

# TCGA/GDC (no key required, but rate-limited)
GDC_API_URL=https://api.gdc.cancer.gov

# GTEx (no key required)
GTEX_PORTAL_URL=https://gtexportal.org/api/v2

# Ensembl REST API (for orthology/gene info)
ENSEMBL_REST_URL=https://rest.ensembl.org

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Celery ---
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/1
